        {"name": "STLLR_AUTH0_OIDC_ISSUER", "secret": "tenant-secrets", "key": "STLLR_AUTH0_OIDC_ISSUER", "value": "https://secret-tenant.example"},
        {"name": "STLLR_REDIS_CONN_STRING", "secret": "tenant-secrets", "key": "STLLR_REDIS_CONN_STRING", "value": "rediss://secret-password@secret-cache.example:25061"}
      ]
    }
  ]
}
